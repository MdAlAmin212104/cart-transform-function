{{ 'saved-cart.css' | asset_url | stylesheet_tag }}

{% if customer %}
<div class="saved-cart-btn-block-container" {{ block.shopify_attributes }}>
  {% render 'save_cart_button',
    button_label: block.settings.button_label,
    button_bg_color: block.settings.button_bg_color,
    button_text_color: block.settings.button_text_color,
    border_radius: block.settings.border_radius
  %}
</div>
{% endif %}

<script src="{{ 'saved-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Save Cart Button",
  "target": "section",
  "stylesheet": "saved-cart.css",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Share Cart Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
