{{ 'saved-cart.css' | asset_url | stylesheet_tag }}

{% if customer %}
<div class="saved-cart-btn-wrapper" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="saved-cart-button {{ block.settings.button_style }}"
    data-saved-cart-trigger
    id="save-cart-btn-{{ block.id }}"
    data-customer-id="{{ customer.id }}"
    data-customer-email="{{ customer.email }}"
    data-customer-name="{{ customer.name }}"
    style="--saved-cart-btn-bg: {{ block.settings.button_bg_color }}; --saved-cart-btn-color: {{ block.settings.button_text_color }}; --saved-cart-radius: {{ block.settings.border_radius }}px;"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <span>{{ block.settings.button_label | default: 'Share Cart Link' }}</span>
  </button>
</div>
{% endif %}

<script src="{{ 'saved-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Save Cart Button",
  "target": "section",
  "stylesheet": "saved-cart.css",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Share Cart Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
